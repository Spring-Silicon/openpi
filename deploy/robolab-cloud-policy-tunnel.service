[Unit]
Description=RoboLab cloud policy and dashboard tunnels
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/spring-openpi/cloud.env
ExecStart=/usr/bin/ssh -NT \
  -i %h/.ssh/robolab-cloud-tunnel \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -R 18000:127.0.0.1:8000 \
  -L ${DASHBOARD_FORWARD} ubuntu@${CLOUD_HOST}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
